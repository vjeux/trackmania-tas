 /// average to his single frame, while 180°-opposed coil frames stay split.
 /// Gated by TINY_USMOOTH=1; runs after VPRIM, before welding. Key (UKEYQ)
 /// consumes the smoothed quantized U.
+/// Re-derive V = sgn(det)*(N x U) for one corner after U was set to
+/// `uavg` (shared by U-cluster and U-corner smoothing so both behave
+/// identically, incl. TINY_KEEPFLATV / TINY_USGN / primary-sign logic).
+fn rederive_v(tris: &mut [[Corner; 3]], ti: usize, k: usize, uavg: [f32; 3], mode: u8) {
+    // TINY_KEEPFLATV=1 keeps the VPRIM-flat V instead.
+    if std::env::var("TINY_KEEPFLATV").is_ok() {
+        return;
+    }
+    let t = &tris[ti];
+    let du1 = t[1].uv[0] - t[0].uv[0];
+    let dv1 = t[1].uv[1] - t[0].uv[1];
+    let du2 = t[2].uv[0] - t[0].uv[0];
+    let dv2 = t[2].uv[1] - t[0].uv[1];
+    let det = du1 * dv2 - du2 * dv1;
+    // V re-derive sign follows the corner's primary: dv corners carry sgn
+    // in U already (USGN) so s=1; du corners need s=sgn(det) as stored.
+    // (No USGN: all s=sgn(det).)
+    let dup = tri_primary_du(&tris[ti], mode);
+    let s = if std::env::var("TINY_USGN").is_ok() && !dup {
+        1.0
+    } else if det.is_sign_negative() {
+        -1.0
+    } else {
+        1.0
+    };
+    let nn = tris[ti][k].normal;
+    let wx = s * (nn[1] * uavg[2] - nn[2] * uavg[1]);
+    let wy = s * (nn[2] * uavg[0] - nn[0] * uavg[2]);
+    let wz = s * (nn[0] * uavg[1] - nn[1] * uavg[0]);
+    let wl = (wx * wx + wy * wy + wz * wz).sqrt().max(1e-30);
+    tris[ti][k].tan_v = [wx / wl, wy / wl, wz / wl];
+}
+
+/// Per-CORNER threshold U averaging (order-free): each corner's U is the
+/// weighted mean of the V-primary frames at its position whose angle to
+/// ITS OWN frame is <= max_deg. Seed-clustering (first-match or Lloyd)
+/// misplaces knife-edge corners (a corner 2.7deg from cluster A processed
+/// after cluster B 59.8deg away joins B; Lloyd migrates true-split outliers
+/// into A): per-corner sets give both the merge and the split correctly.
+/// V re-derived per corner exactly like the cluster path.
+pub fn smooth_u_corner(tris: &mut [[Corner; 3]], max_deg: f32, angle_weight: bool, mag_weight: bool, mode: u8) {
+    use std::collections::BTreeMap;
+    if max_deg <= 0.0 {
+        return;
+    }
+    let cos_max = (max_deg.to_radians()).cos();
+    let mut by_pos: BTreeMap<[u32; 3], Vec<(usize, usize)>> = BTreeMap::new();
+    for (ti, t) in tris.iter().enumerate() {
+        for (k, c) in t.iter().enumerate() {
+            if c.tan_u == [0.0; 3] {
+                continue;
+            }
+            by_pos
+                .entry([c.pos[0].to_bits(), c.pos[1].to_bits(), c.pos[2].to_bits()])
+                .or_default()
+                .push((ti, k));
+        }
+    }
+    for (_, corners) in by_pos {
+        if corners.len() < 2 {
+            continue;
+        }
+        let mut out: Vec<[f32; 3]> = Vec::with_capacity(corners.len());
+        for i in 0..corners.len() {
+            let (mti, mk) = corners[i];
+            let me = tris[mti][mk].tan_u;
+            let mut acc = [0.0f64; 3];
+            let mut wsum = 0.0f64;
+            for &(ti, k) in &corners {
+                let u = tris[ti][k].tan_u;
+                if me[0] * u[0] + me[1] * u[1] + me[2] * u[2] < cos_max {
+                    continue;
+                }
+                let w = if mag_weight {
+                    du_grad_mag(&tris[ti])
+                } else if angle_weight {
+                    corner_angle(&tris[ti], k) as f64
+                } else {
+                    1.0
+                };
+                for d in 0..3 {
+                    acc[d] += u[d] as f64 * w;
+                }
+                wsum += w;
+            }
+            let lavg = (acc[0] * acc[0] + acc[1] * acc[1] + acc[2] * acc[2]).sqrt().max(1e-30);
+            out.push([(acc[0] / lavg) as f32, (acc[1] / lavg) as f32, (acc[2] / lavg) as f32]);
+        }
+        for (i, &(ti, k)) in corners.iter().enumerate() {
+            tris[ti][k].tan_u = out[i];
+            rederive_v(tris, ti, k, out[i], mode);
+        }
+    }
+}
