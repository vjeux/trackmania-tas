string V3(const vec3 &in v){return Text::Format("%.2f",v.x)+","+Text::Format("%.2f",v.y)+","+Text::Format("%.2f",v.z);}
void Probe(CGameCtnEditorFree@ ed){auto ch=ed.Challenge;IO::File f(IO::FromDataFolder("probe-out.tsv"),IO::FileMode::Write);f.Write("copper\t"+ch.CopperPrice+"\n");f.Write("collection\t"+ch.CollectionName+"\t"+ch.DecorationName+"\t"+(ch.Collection is null?"null":ch.Collection.IdName)+"\n");f.Write("kind\tindex\tmodel\tauthor\tpos\tscale\tmodel_loaded\tentity_model\tyaw\tpitch\troll\n");for(uint i=0;i<ch.AnchoredObjects.Length;i++){auto o=ch.AnchoredObjects[i];string em="null";string loaded="0";if(o.ItemModel!is null){loaded="1";if(o.ItemModel.EntityModel!is null)em=Reflection::TypeOf(o.ItemModel.EntityModel).Name;}string nm="?";if(o.ItemModel!is null){nm=o.ItemModel.IdName;}f.Write("item\t"+i+"\t"+nm+"\t"+(o.ItemModel!is null?o.ItemModel.Author.GetName():"")+"\t"+V3(o.AbsolutePositionInMap)+"\t"+o.Scale+"\t"+loaded+"\t"+em+"\t"+Text::Format("%.4f",o.Yaw)+"\t"+Text::Format("%.4f",o.Pitch)+"\t"+Text::Format("%.4f",o.Roll)+"\n");}f.Write("blocks\t"+ch.Blocks.Length+"\n");for(uint i=0;i<ch.Blocks.Length;i++){auto b=ch.Blocks[i];f.Write("block\t"+i+"\t"+b.BlockInfo.Name+"\t"+(b.IsGhostBlock()?"ghost":"")+"\t"+b.CoordX+","+b.CoordY+","+b.CoordZ+"\t"+b.Dir+"\t\t\n");}f.Close();print("PROBE "+ch.AnchoredObjects.Length+" items");}
void CarProbe(){auto app=GetApp();auto pg=app.CurrentPlayground;if(pg is null||pg.GameTerminals.Length==0)return;auto pl=cast<CSmPlayer>(pg.GameTerminals[0].ControlledPlayer);IO::File f(IO::FromDataFolder("car-out.tsv"),IO::FileMode::Write);if(pl!is null&&pl.ScriptAPI!is null){auto sa=cast<CSmScriptPlayer>(pl.ScriptAPI);f.Write("pos\t"+sa.Position.x+"\t"+sa.Position.y+"\t"+sa.Position.z+"\tspeed\t"+sa.Speed+"\n");}f.Close();print("CARPROBE");}
