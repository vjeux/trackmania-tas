#!/bin/bash
# gsdev -- plugin dev loop. Thin wrapper over `shootctl`; all logic is Rust.
#
# WHY A LINT STEP: self-reload works and takes about a second. What costs a
# 90-second game restart is a COMPILE ERROR -- Openplanet unloads the plugin,
# the HTTP server goes with it, and there is no /reload left to call. Every
# restart in this session was one of my own edits naming a class or writing a
# const property. shootctl checks both against the game's own class dump before
# the game ever sees the file.
set -u
P=/mnt/c/Users/vjeux/OpenplanetNext/Plugins/GhostShooter
GOOD=$HOME/gs-good
API=/mnt/c/Users/vjeux/OpenplanetNext/OpenplanetNext.json
S=$HOME/shootctl/target/release/shootctl

case "${1:-}" in
  save)
    mkdir -p "$GOOD" && rm -f "$GOOD"/*.as && cp -f "$P"/*.as "$GOOD"/ \
      && echo "saved $(ls "$GOOD" | wc -l) files as the known-good plugin"
    ;;
  lint) "$S" lint "$API" "$P"/*.as ;;
  install)
    "$S" lint "$API" "$P"/*.as || { echo "REFUSING to install"; exit 1; }
    STAMP="B$(date +%s)"
    "$S" stamp "$P/Main.as" "$STAMP" >/dev/null
    "$S" get /reload >/dev/null
    for i in $(seq 1 20); do
      [ "$("$S" get /build 2>/dev/null)" = "$STAMP" ] && { echo "RELOADED ok ($STAMP)"; exit 0; }
      sleep 0.5
    done
    echo "RELOAD FAILED -- errors the linter did not catch:"
    grep "ERR" /mnt/c/Users/vjeux/OpenplanetNext/Openplanet.log | grep -v UltimateMedals | tail -5
    for f in "$P"/*.as; do
      [ -f "$GOOD/$(basename "$f")" ] || { rm -f "$f"; echo "removed new-and-broken $(basename "$f")"; }
    done
    cp -f "$GOOD"/*.as "$P"/ 2>/dev/null && echo "restored the last good plugin"
    "$S" get /ping >/dev/null 2>&1 || {
      echo "server is down; restarting the game"
      /mnt/c/Windows/System32/taskkill.exe /F /IM Trackmania.exe >/dev/null 2>&1
      sleep 4
      bash ~/trackmania-tas/tools/launch_tm.sh 2>&1 | grep -E "PLUGIN UP|FAIL"
    }
    exit 1
    ;;
  *) echo "usage: gsdev save|lint|install"; exit 2 ;;
esac
